#!/usr/bin/env python3
"""Save, list, load, and rename songwriter projects as one JSON file each."""

from __future__ import annotations

import fcntl
import json
import os
import re
import sys
import tempfile
from pathlib import Path

MAX_JSON_BYTES = 4_194_304
MAX_PROJECTS = 200
MAX_TITLE_LEN = 80
MAX_ID_LEN = 96
ILLEGAL_STEM = re.compile(r'[\\/:\0<>"|?*]')


def die(message: str, code: int) -> None:
    sys.stderr.write(message + "\n")
    raise SystemExit(code)


def data_dir() -> Path:
    root = os.environ.get("XDG_DATA_HOME")
    if root:
        return Path(root) / "songwriter"
    return Path.home() / ".local/share" / "songwriter"


def projects_dir() -> Path:
    return data_dir() / "projects"


def runtime_dir() -> Path:
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        die("Songwriter library requires XDG_RUNTIME_DIR", 2)
    path = Path(runtime) / "omarchy-songwriter"
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    return path


def selection_path() -> Path:
    return runtime_dir() / "save-selection.json"


def acquire_lock() -> int:
    root = data_dir()
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    projects_dir().mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(root / "projects.lock", os.O_CREAT | os.O_RDWR, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def normalize_title(raw: object) -> str:
    text = raw.strip() if isinstance(raw, str) else ""
    if not text:
        return "Untitled"
    if len(text) > MAX_TITLE_LEN:
        text = text[:MAX_TITLE_LEN]
    return text


def slugify(title: str) -> str:
    text = ILLEGAL_STEM.sub("-", normalize_title(title))
    text = re.sub(r"\s+", " ", text).strip(" .")
    if not text or text in (".", ".."):
        text = "Untitled"
    if len(text) > MAX_TITLE_LEN:
        text = text[:MAX_TITLE_LEN].rstrip(" .") or "Untitled"
    return text


def safe_stem(raw: object) -> str:
    if not isinstance(raw, str):
        return ""
    stem = raw.strip()
    if not stem or stem in (".", ".."):
        return ""
    if "/" in stem or "\\" in stem or "\0" in stem:
        return ""
    if len(stem) > MAX_ID_LEN:
        return ""
    if ILLEGAL_STEM.search(stem):
        return ""
    return stem


def looks_like_song(raw: object) -> bool:
    if not isinstance(raw, dict):
        return False
    sections = raw.get("sections")
    return isinstance(sections, list) and len(sections) > 0


def atomic_write(path: Path, data: str) -> None:
    encoded = data.encode("utf-8")
    if len(encoded) > MAX_JSON_BYTES:
        die(f"payload exceeds {MAX_JSON_BYTES} bytes", 2)
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(
        prefix=f".{path.name}.",
        suffix=".tmp",
        dir=str(path.parent),
    )
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp_name, path)
    except Exception:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass
        raise


def unique_path(directory: Path, stem: str, exclude: Path | None = None) -> Path:
    def same(path: Path) -> bool:
        if exclude is None or not exclude.exists() or not path.exists():
            return False
        try:
            return path.resolve() == exclude.resolve()
        except OSError:
            return False

    candidate = directory / f"{stem}.json"
    if not candidate.exists() or same(candidate):
        return candidate
    n = 2
    while n <= 999:
        suffix = f"-{n}"
        room = MAX_ID_LEN - len(suffix)
        clipped = stem if len(stem) <= room else stem[:room].rstrip(" .-") or "Untitled"
        candidate = directory / f"{clipped}{suffix}.json"
        if not candidate.exists() or same(candidate):
            return candidate
        n += 1
    die("too many projects with that name", 2)
    raise AssertionError


def extract_entry(payload: dict) -> tuple[str, str, dict]:
    nested = payload.get("song")
    if isinstance(nested, dict) and looks_like_song(nested):
        song = dict(nested)
        title = normalize_title(payload.get("title") or nested.get("title"))
        pid = safe_stem(payload.get("id") or nested.get("id"))
    elif looks_like_song(payload):
        song = {key: value for key, value in payload.items() if key != "updatedAt"}
        title = normalize_title(payload.get("title"))
        pid = safe_stem(payload.get("id"))
    else:
        die("Invalid save selection", 2)
        raise AssertionError
    song["title"] = title
    return pid, title, song


def project_record(path: Path) -> dict[str, str]:
    rec = {"id": path.stem, "title": path.stem, "file": path.name}
    try:
        if path.stat().st_size > MAX_JSON_BYTES:
            return rec
        data = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            title = normalize_title(data.get("title"))
            if title:
                rec["title"] = title
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError):
        pass
    return rec


def list_projects() -> list[dict[str, str]]:
    items: list[tuple[float, dict[str, str]]] = []
    if not projects_dir().is_dir():
        return []
    for path in projects_dir().glob("*.json"):
        if not path.is_file():
            continue
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        items.append((mtime, project_record(path)))
    items.sort(key=lambda pair: pair[0], reverse=True)
    return [rec for _, rec in items[:MAX_PROJECTS]]


def dump_projects() -> None:
    sys.stdout.write(json.dumps({"projects": list_projects()}, separators=(",", ":")) + "\n")


def migrate_library() -> None:
    library_file = data_dir() / "library.json"
    if not library_file.is_file():
        return
    try:
        raw = library_file.read_bytes()
        if len(raw) > MAX_JSON_BYTES:
            return
        data = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError):
        return
    songs = data.get("songs") if isinstance(data, dict) else None
    if not isinstance(songs, list):
        return
    for entry in songs:
        if not isinstance(entry, dict):
            continue
        nested = entry.get("song") if isinstance(entry.get("song"), dict) else None
        song = nested if nested is not None else entry
        if not looks_like_song(song):
            continue
        title = normalize_title(entry.get("title") or song.get("title"))
        dest = unique_path(projects_dir(), slugify(title))
        body = dict(song)
        body["title"] = title
        body["id"] = dest.stem
        try:
            atomic_write(dest, json.dumps(body, separators=(",", ":")) + "\n")
        except OSError:
            continue
    bak = data_dir() / "library.json.bak"
    try:
        if bak.exists():
            library_file.unlink()
        else:
            library_file.replace(bak)
    except OSError:
        pass


def cmd_list() -> int:
    dump_projects()
    return 0


def cmd_save() -> int:
    path = selection_path()
    if not path.is_file():
        die(f"Missing save selection: {path}", 2)
    try:
        raw = path.read_bytes()
        if not raw or len(raw) > MAX_JSON_BYTES:
            die("Invalid save selection", 2)
        payload = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError):
        die("Invalid save selection", 2)
        raise AssertionError
    if not isinstance(payload, dict):
        die("Invalid save selection", 2)

    current_id, title, song = extract_entry(payload)
    dest_dir = projects_dir()
    current_path = dest_dir / f"{current_id}.json" if current_id else None
    if current_path is not None and not current_path.is_file():
        current_path = None

    stem = slugify(title)
    if current_path is None:
        # Name is the file. A first save (or a stale id) writes/overwrites
        # that title's JSON so Open/Save stay on the same project.
        target = dest_dir / f"{stem}.json"
    else:
        target = unique_path(dest_dir, stem, exclude=current_path)
    song["title"] = title
    song["id"] = target.stem
    try:
        atomic_write(target, json.dumps(song, separators=(",", ":")) + "\n")
    except OSError as exc:
        die(f"Songwriter could not save the project: {exc}", 1)

    if current_path is not None:
        try:
            if current_path.resolve() != target.resolve():
                current_path.unlink()
        except OSError:
            pass

    sys.stdout.write(
        json.dumps(
            {
                "id": target.stem,
                "title": title,
                "file": target.name,
                "projects": list_projects(),
            },
            separators=(",", ":"),
        )
        + "\n"
    )
    return 0


def cmd_load(project_id: str) -> int:
    stem = safe_stem(project_id)
    if not stem:
        die("load requires a project id", 2)
    path = projects_dir() / f"{stem}.json"
    if not path.is_file():
        die(f"Project not found: {stem}", 2)
    try:
        if path.stat().st_size > MAX_JSON_BYTES:
            die("Project file is too large", 2)
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError):
        die("Project file is invalid", 2)
        raise AssertionError
    if not looks_like_song(data):
        die("Project file is invalid", 2)
    if isinstance(data, dict):
        data["id"] = stem
        if not str(data.get("title") or "").strip():
            data["title"] = stem
    sys.stdout.write(json.dumps(data, separators=(",", ":")) + "\n")
    return 0


def cmd_delete(project_id: str) -> int:
    stem = safe_stem(project_id)
    if not stem:
        die("delete requires an id", 2)
    path = projects_dir() / f"{stem}.json"
    try:
        if path.is_file():
            path.unlink()
    except OSError as exc:
        die(f"Songwriter could not remove the project: {exc}", 1)
    dump_projects()
    return 0


def main(argv: list[str]) -> int:
    acquire_lock()
    migrate_library()
    action = argv[0] if argv else "list"
    if action in ("list", "get"):
        return cmd_list()
    if action == "save":
        return cmd_save()
    if action == "load":
        return cmd_load(argv[1] if len(argv) > 1 else "")
    if action == "delete":
        return cmd_delete(argv[1] if len(argv) > 1 else "")
    die(f"Unknown action: {action}", 2)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
