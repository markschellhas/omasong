#!/usr/bin/env python3
"""Read chord progressions from a running overlay or the last snapshot."""

from __future__ import annotations

import importlib.util
import sys
from pathlib import Path

_SERVER = Path(__file__).resolve().parent / "agent-server.py"
_SPEC = importlib.util.spec_from_file_location("agent_server", _SERVER)
if _SPEC is None or _SPEC.loader is None:
    sys.stderr.write("chords-agent: missing agent-server.py\n")
    raise SystemExit(2)
agent_server = importlib.util.module_from_spec(_SPEC)
_SPEC.loader.exec_module(agent_server)


def usage(out) -> None:
    out.write(
        "chords-agent — read chord progressions from a running songwriter overlay\n"
        "\n"
        "Usage:\n"
        "  chords-agent progressions [--live]\n"
        "  chords-agent song [--live]\n"
        "  chords-agent health\n"
        "\n"
        "progressions  Chords that have been placed, grouped by section.\n"
        "song          Full song document; empty slots are null.\n"
        "health        Whether the app is serving live state (exit 0 / 2).\n"
        "\n"
        "By default, progressions/song use the live loopback API, then the\n"
        "last snapshot under $CHORDS_AGENT_HOME (or ~/.config/songwriter).\n"
        "--live fails if the app is not running.\n"
        "\n"
        "Port: $CHORDS_AGENT_PORT, else agent-api.json, else 17891.\n"
    )


def print_body(body: str) -> None:
    sys.stdout.write(body)
    if not body.endswith("\n"):
        sys.stdout.write("\n")


def print_document(route: str, snapshot: str, live_only: bool) -> int:
    if live_only:
        port = agent_server.discover_agent_port()
        status, body = agent_server.http_get_local(port, route)
        if status != 200 or not body:
            sys.stderr.write(
                f"chords-agent: app is not reachable on 127.0.0.1:{port}\n"
            )
            return 2
        print_body(body)
        return 0

    body = agent_server.read_agent_document(route, snapshot)
    if body is None:
        sys.stderr.write(
            f"chords-agent: no live API and no snapshot for {snapshot}\n"
        )
        return 2
    print_body(body)
    return 0


def main(argv: list[str]) -> int:
    live_only = False
    command = None
    for arg in argv:
        if arg in ("-h", "--help"):
            usage(sys.stdout)
            return 0
        if arg == "--live":
            live_only = True
            continue
        if arg.startswith("-"):
            sys.stderr.write(f"chords-agent: unknown option {arg}\n")
            return 1
        if command is not None:
            usage(sys.stderr)
            return 1
        command = arg

    if command is None:
        usage(sys.stderr)
        return 1

    if command == "progressions":
        return print_document("/progressions", "progressions.json", live_only)
    if command == "song":
        return print_document("/song", "song.json", live_only)
    if command == "health":
        if agent_server.agent_is_live():
            port = agent_server.discover_agent_port()
            print_body(f'{{"ok":true,"port":{port}}}')
            return 0
        print_body('{"ok":false}')
        return 2

    sys.stderr.write(f"chords-agent: unknown command {command}\n")
    usage(sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
